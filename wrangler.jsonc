/**
 * Yurguen / DevOps: Worker de APP (Contabilidad + Bitácora + APIs).
 * Dominio: app.exhatech.com
 * Sitio marketing: Cloudflare Pages (exhatech.com) — no este Worker.
 *
 * Secrets NUNCA van acá: `wrangler secret put` o `.dev.vars` (local).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exhatech",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "app.exhatech.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // none: no servir HTML 404 genérico que el front confunde con respuesta de API.
    "not_found_handling": "none",
    // true: el Worker SIEMPRE corre primero (APIs + rewrites /contabilidad /bitacora).
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "ExhaTech",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exhatech-db",
      "database_id": "523ca9f9-20f9-4b1e-b248-144d43eee5a8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "exhatech-data"
      // Objetos por usuario: budgets/{userId}.json, foco/{userId}.json
    }
  ]
  // Secrets (no declarar valores aquí):
  //   SESSION_SECRET          — firmar / hashear tokens de sesión
  //   DATA_ENCRYPTION_KEY     — mismo rol que data/budget.master.local; cifra JSON en R2
  //   BUDGET_MASTER_KEY       — compat opcional si ya usás ese nombre en CI/secret store
  //   SEED_ADMIN_PASSWORD     — opcional; crea admin una vez si D1 arranca vacío
}
